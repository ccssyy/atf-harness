{
  "name": "atf-harness",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "ATF 独立训练 Harness（R2a：TS L2-L4 + Python 内核经 stdio JSONL 桥接，零 npm 运行时依赖）",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run typecheck && vitest run",
    "smoke:s1": "npm run build && node dist/bridge/smoke.js",
    "smoke:gate1a": "npm run build && node dist/agent/main.js",
    "trial:gate1a-real": "npm run build && node dist/agent/main.js --peer real",
    "codegen:stage-order": "node tools/codegen-stage-order.mjs",
    "codegen:reason-categories": "node tools/codegen-reason-categories.mjs",
    "prebuild": "npm run codegen:stage-order && npm run codegen:stage-params && npm run codegen:stage-matrix && npm run codegen:reason-categories && git diff --exit-code -- src/core/generated || (echo \"生成物漂移:内核段序/三分表变更后须重跑 codegen 并随批提交\" && exit 1)",
    "codegen:stage-params": "node tools/codegen-stage-params.mjs",
    "codegen:stage-matrix": "node tools/codegen-stage-matrix.mjs",
    "rehearsal": "node --import ./vendor/dsh/deepseek-harness/node_modules/tsx/dist/esm/index.mjs deploy/verify/rehearsal/journey.ts",
    "rehearsal:break": "node --import ./vendor/dsh/deepseek-harness/node_modules/tsx/dist/esm/index.mjs deploy/verify/rehearsal/journey.ts --break-step 06-snapshot",
    "pregate": "bash deploy/verify/pregate.sh",
    "pregate:fast": "bash deploy/verify/pregate.sh --fast",
    "pregate:release": "bash deploy/verify/pregate.sh --require-rehearsal",
    "audit:vendor-overlap": "node tools/audit-vendor-overlap.mjs",
    "audit:module-overlap": "node tools/audit-module-overlap.mjs",
    "audit:all": "npm run audit:vendor-overlap && npm run audit:module-overlap && npm run audit:cross-repo-overlap && npm run audit:architectural-decay",
    "audit:cross-repo-overlap": "node tools/audit-cross-repo-overlap.mjs",
    "audit:architectural-decay": "node tools/audit-architectural-decay.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1"
  }
}
