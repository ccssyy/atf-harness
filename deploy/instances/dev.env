# dev 实例 boot env（实例层——gitignored）
# ============================================================================
# 批㊶-ISO-2 生效段（决议 D1①/D2①/D3①，2026-10-13）：pin 分实例／bridge 指 pin／
# runs 别名迁移——canonical 单源化（净室重启 instance-restart.sh dev 全量承载）。
# ============================================================================
# —— S1/D1①：实例 pin 根（worktree 检出 v0.7.13b0；消费链单源 instancePin.ts）——
export ATF_INSTANCE_PIN_ROOT='/data/atf/dev/pinned'
# —— #22 单版本源（批4 部署收敛，r2 教训：三指针三版本=删参/漂移事故温床）——
# 三指针同根派生：kernelDir（scratch PYTHONPATH/preflight/attachments）＋段 CLI＋bridge
# 一次切换全生效（回滚 pinned 只改下一行一处）。自检=deploy/verify/check-kernel-single-source.sh。
export ATF_KERNEL_SOURCE='/data/sam/AgenticTrainingFlow'  # 治本验收期=主仓 main（M4b 验收期指针的正式化）
export ATF_DSH_KERNEL_DIR="$ATF_KERNEL_SOURCE"
# D1① 指向切换（原逐字指共享 .atf-pinned——S1 审计劫持面收口）
# 批㊶-PRODTEST（2026-10-17·zcode 按 P0 处置指令续批）：测试工作区声明进文件工具围栏——
# 内核 auto 形态准入/切分需读真实文件；产品报错自带指引（ATF_V1_FILE_TOOL_ROOTS 可追加）。
# 批D2 走查（2026-10-19）：prodtest 追加正式撤销——⑦注册工作区派生面接管（realpath 去重
# 后白名单有效根集合不变，boot 锚 11 根恰等；⑦缺席时以本行追加为退路——注释保留指路）。
# b11：注册工作区定域闸——实例根外的工作区不进白名单；下列历史验证工作区属「实例根外但确需读写」，按声明面（本键即例外通道）登记。
# 未在此声明且不在实例根内的注册工作区，重启后会被排除并在白名单热加载日志里列出。
export ATF_V1_FILE_TOOL_ROOTS="/data/atf/dev/pinned:/data/LLM_model:/data/atf/dev/ws-batcha-verify:/data/atf/dev/validate-20261025"
# 批㊶-PRODTEST（2026-10-17·zcode 续批第二笔环境声明）：内核准入面工作区白名单附加集——
# 产品报错指引 ATF_WORKSPACE_ALLOWLIST「只装配置外素材根，部署时按实例填值」（pinned tools.py:672）。
export ATF_WORKSPACE_ALLOWLIST=/data/atf/instances/dev/atf-home/workspaces:/data/atf/instances/dev/atf-home/attachments  # D169/D21 收敛:实例家工作区根+素材根(2026-10-31)
export ATF_DSH_PIPELINE_COMMAND="python3 $ATF_KERNEL_SOURCE/skills/atf-admit-training-data/scripts/walkthrough_pipeline.py"  # D217 单源化:段逻辑唯一源=skills 版
# —— D2①：bridge 指 pin（PYTHONPATH 前置模板——实载随 pin 走，ISO-2 定形冒烟已锚）——
export ATF_DSH_BRIDGE_COMMAND="PYTHONPATH=$ATF_KERNEL_SOURCE/src python3 -m agentic_training_flow serve"  # #22 单源派生（切换只改 ATF_KERNEL_SOURCE）
# —— D3①：RUNS_ROOT 别名（symlink→walkthrough runs，零搬移；容器无 mount 权限，
# bind mount 改 symlink 等价别名——已登记执行报告候验）——
export ATF_DSH_RUNS_ROOT='/data/atf/dev/runs'
# —— S3：EXEC_HOME/SESSIONS_ROOT 显式化（沿 -dev 惯例；原走仓内缺省）——
export ATF_DSH_EXEC_HOME='/data/sam/ATF-Harness/tmp/atf-exec-home-dev'
export ATF_WEBUI_SESSIONS_ROOT='/data/sam/ATF-Harness/tmp/webui-sessions-dev'
# —— 批㊶-ISO E1：tmux 会话命名域前缀（dev 实例会话名＝dev-＋基名）——
export ATF_TMUX_SESSION_PREFIX='dev-'
# —— 功能等价迁移（原 tmux 会话遗留 inline export——净室重启后由本文件 canonical 承载）——
export ATF_APPROVAL_LEDGER='/root/.atf/approval-ledger/training-release.jsonl'
export ATF_MODEL_ROOT='/data/LLM_model'
export ATF_LLM_CONFIG='/root/.atf-harness/llm-piai-walkthrough-glm.json'
export ATF_DSH_LOG_DIR='/data/atf/dev/runs/run-regress-formal-01/training-logs'
# —— 目录结构 v1（2026-10-16 批㊶-W2 T4 彩排）：dev 家迁 /data/atf/instances/dev/atf-home
# （poc/dsh-home 冷备原样保留；~/.atf 软链指向新家——ATF_APPROVAL_LEDGER 经软链解析不变）——
export DSH_HOME='/data/atf/instances/dev/atf-home'
export HOME='/root'
export ATF_SKILLS_AUTO_INSTALL=0

# —— 启动自足面（2026-10-28 env 收敛）：净室启动不再依赖 env dump ——
# 原来 dev 有两套 env（dev-web.env dump ＋ 本文件），改一份不生效；现只留本文件为真源，
# 密钥走 /root/.atf-harness/.env，启动器 source 两者后直接 exec node（不经 pnpm）。
export NODE='/root/.nvm/versions/node/v24.16.0/bin/node'
export COREPACK_ROOT='/root/.nvm/versions/node/v24.16.0/lib/node_modules/corepack'
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/root/.nvm/versions/node/v24.16.0/bin${PATH:+:$PATH}"
export ATF_INSTANCE_ROOT='/data/atf/instances/dev/atf-home'
# 「添加工作区」对话框的缺省根（vendor patch 0007）：缺省是宿主家目录，实例里那不是资产根——
# 指到实例根内的工作区目录，用户新建的工作区天然落在定域范围（白名单才放行）。
export DSH_WORKSPACE_PICKER_ROOT='/data/atf/instances/dev/atf-home/workspaces'

# 固定 launch token（owner 2026-10-28 授权：内部环境使用、公网端口转发由腾讯云安全组控制）
# 消费点实测：vendor dsh `packages/client/connection/src/browser-auth.ts:55` 与
# `lib/index.js:247`（package main 指 lib/index.js，运行期读的就是 lib 那份）；
# 取 32 字节随机 → base64url 无 padding ＝ 43 字符（SECRET_BYTES=32）；比对为逐字节字符串相等。
# 历史注释「DSH_WEB_LAUNCH_TOKEN 全仓零消费」系过期信息，已于 10-28 实测推翻并作废。
export DSH_WEB_LAUNCH_TOKEN='n4I2Yg3zmwIBhcQdhLhXEtri1p8Xt2g9SSe8VUag_fU'
# 运行时库路径：容器内 python3 是本地编译版，缺这段会 libpython3.10.so.1.0 加载失败
# （表现为 atf-tools 预检 L2 fail-fast：python3 不可用；env dump 时代靠继承侥幸可用）
export LD_LIBRARY_PATH='/usr/local/lib:/usr/local/lib64'
# bash 会话透传（vendor patch 0008）：容器里本地编译的 python3 需 LD_LIBRARY_PATH 才能
# 加载 libpython 扩展；不声明＝行为不变（dsh 的 shell env 只带 DSH_* 快照）。
export DSH_BASH_PASSTHROUGH_ENV='LD_LIBRARY_PATH'
