# uat 实例 boot env 声明样例（变量名占位——真实值在 deploy/instances/<实例>.env，
# 入 .gitignore；boot 命令 set -a source 之。白名单随声明面自动重建——
# 换环境/换机器＝改本文件，产品资产零改动）。
# 派生集（产品代码镜像，勿在此重复）：ATF_DSH_RUNS_ROOT／$HOME/.atf/config.json
#   workspace_root／.atf/env-profiles/* 的 train_env/eval_env／ATF_DSH_KERNEL_DIR
#   （或 ATF_CLI_PATH）／ATF_DSH_EXEC_HOME／ATF_DSH_LOG_DIR。
# 附加集（派生集未覆盖的目录——如外部数据批根、权重根）在此声明，冒号分隔：
export ATF_V1_FILE_TOOL_ROOTS="<外部数据根1>:<外部数据根2>:<权重根>"
# GPU 排队编排轮询周期（毫秒；缺省 300000；0＝不启用排队直启）：
export ATF_GPU_POLL_MS=300000
# 桥注入（真内核 serve argv——PYTHONPATH 由 harness 自内核目录派生，勿手工设进程面）：
export ATF_DSH_BRIDGE_COMMAND='python3 -m agentic_training_flow serve'
# 固定 token（uat 语义，重启不换）：
export DSH_WEB_LAUNCH_TOKEN='<固定 token>'
