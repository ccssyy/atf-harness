# uat 实例 boot env 声明样例（变量名占位——真实值在 deploy/instances/uat.env，入 .gitignore；
# boot 命令 set -a source 之。白名单随声明面自动重建——换环境/换机器＝改本文件，产品资产零改动）。
# 实例拓扑（批㊶-OPSREPO v2）：UAT 本体＝atf-uat 独立容器（dsh 3081→容器内转发器 13081→公网
# 124.220.53.207:13081）；本文件随共享 /data 双侧同路径可见，boot 在容器内执行。
# 派生集（产品代码镜像，勿在此重复）：$HOME/.atf/config.json workspace_root／.atf/env-profiles/*
#   的 train_env/eval_env／ATF_DSH_KERNEL_DIR（或 ATF_CLI_PATH）。
# 本样例与 uat.env 实际声明的变量名一一对齐（批㊶-OPSREPO T0；改 uat.env 变量面须同步本件）：
# 外部数据根白名单（V1 file 工具——白名单附加集，冒号分隔）：
export ATF_V1_FILE_TOOL_ROOTS="<外部数据根1>:<外部数据根2>:<权重根>"
# 单树 runs 根（工具链写入/监控扫描/模型文件面三面同源）：
export ATF_DSH_RUNS_ROOT='<实例 runs 根>'
# 桥注入（真内核 serve argv——PYTHONPATH 由 harness 自内核目录派生，勿手工设进程面）：
export ATF_DSH_BRIDGE_COMMAND='PYTHONPATH=<内核pin副本>/src python3 -m agentic_training_flow serve'
# 管线对端真命令（批㊶-W F4——walkthrough_pipeline.py 于内核 pin 副本 tools/ 下）：
export ATF_DSH_PIPELINE_COMMAND='python3 <内核pin副本>/tools/walkthrough_pipeline.py'
# 放行账本单源（批㊶Q增补三 段1①——绝对路径实例化；写入方与 train.sh 检查器同源；
# env 配置而目录不可写即 fail-fast 拒绝启动）：
export ATF_APPROVAL_LEDGER='<实例 DSH_HOME>/.atf/approval-ledger/training-release.jsonl'
# 本机模型清单根（启动扫描入 boot 日志/start 面复核回流）：
export ATF_MODEL_ROOT='<模型清单根>'
# 实例工作目录束（DSH_HOME 与 HOME 同值——脚本零硬编码 env 单源）：
export DSH_HOME='<实例 home 根>'
export HOME='<实例 home 根>'
# 会话/exec/log 三根（webui 会话、受控执行 home、atf 日志目录）：
export ATF_WEBUI_SESSIONS_ROOT='<webui 会话根>'
export ATF_DSH_EXEC_HOME='<exec home 根>'
export ATF_DSH_LOG_DIR='<atf 日志根>'
# tmux 会话命名域前缀（实例内编排会话名＝前缀＋基名）：
export ATF_TMUX_SESSION_PREFIX='uat-'
# 内核 pin 根（ISO-2 指向切换轴）：
export ATF_INSTANCE_PIN_ROOT='<内核 pin 根>'
# 内核技能自举关闭（re-pin v0.7.19b0 起——serve/main 入口 ensure_skills_installed 缺省写
# HOME/.agents/skills，实例面关闭；对齐 dev.env 既有行）：
export ATF_SKILLS_AUTO_INSTALL=0
# GPU 排队编排轮询周期（毫秒；缺省 30000——与代码缺省 GPU_QUEUE_POLL_MS_DEFAULT 一致，
# 批㊶-S4b T2 样例漂移更正；0＝不启用排队直启。uat.env 未声明时走代码缺省）：
export ATF_GPU_POLL_MS=30000
# launch token（批㊶-OPSREPO T2 源码定案——无固定 token 绑定点，本样例不设 token 变量）：
# vendor `dsh web` launch token 每进程随机生成（packages/client/connection browser-auth
# processLaunchToken：WeakMap 私有；CLI 旗面闭集 --host/--no-open/--port/--trusted-host
# 无 --token；DSH_WEB_LAUNCH_TOKEN 全仓零消费），每次 boot 轮换。token 从 boot 日志提取，
# uat-deploy.sh／instance-restart.sh boot 完成时打印完整公网 URL
# （http://124.220.53.207:13081/?token=…）；已登录浏览器凭 30 天签名 cookie 跨重启存续。
