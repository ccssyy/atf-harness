+/* Form panel (ATF 批㊶-W F5 patch 0003) — shares the visual language of the
+ * plan review card: a framed card with a state strip, a body, and a footer. */
+
+.frame {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 8px;
+}
+
+.card {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 16px;
+  border: 1px solid var(--dsh-border-color, rgba(0, 0, 0, 0.12));
+  border-radius: 12px;
+  background: var(--dsh-surface-color, #fff);
+}
+
+.strip {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  text-transform: uppercase;
+  opacity: 0.75;
+}
+
+.body {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.title {
+  margin: 0;
+  font-size: 15px;
+  font-weight: 600;
+}
+
+.detail {
+  margin: 0;
+  font-size: 12px;
+  opacity: 0.75;
+  white-space: pre-wrap;
+}
+
+.fields {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  max-height: 320px;
+  overflow-y: auto;
+  padding-right: 4px;
+}
+
+.fieldRow {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.fieldLabel {
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.requiredMark {
+  margin-left: 2px;
+  color: #d64545;
+}
+
+.fieldInput {
+  width: 100%;
+  box-sizing: border-box;
+  padding: 6px 8px;
+  font: inherit;
+  font-size: 13px;
+  border: 1px solid var(--dsh-border-color, rgba(0, 0, 0, 0.16));
+  border-radius: 8px;
+  background: transparent;
+  color: inherit;
+  resize: vertical;
+}
+
+.fieldInput:focus {
+  outline: none;
+  border-color: var(--dsh-accent-color, #4b6bfb);
+}
+
+.fieldInput:disabled {
+  opacity: 0.6;
+}
+
+.fieldHint {
+  font-size: 11px;
+  opacity: 0.65;
+}
+
+.footer {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.feedback {
+  flex: 1;
+  min-height: 18px;
+  font-size: 12px;
+  color: #d64545;
+  white-space: pre-wrap;
+}
+
+.actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
