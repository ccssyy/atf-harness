+/**
+ * A request narrowed to the `form` presentation intent (ATF 批㊶-W F5 patch 0003):
+ * everything the form card renders and answers with. Each field is prefilled
+ * from its `value` and the submit encodes every field as a `key=value` entry
+ * of the answer's `selected` — the protocol encoding is unchanged.
+ */
+export interface QuestionForm {
+  /** The form question's id, echoed in the answer. */
+  id: string
+  /** The question text, kept as the card's accessible name. */
+  question: string
+  /** Optional short heading/group label. */
+  header?: string
+  /** Optional supporting detail rendered above the fields. */
+  detail?: string
+  /** Field spec (non-empty — `formOf` narrows it). */
+  fields: readonly AskUserQuestionFormField[]
+  /** Submit button label; the locale default covers it when absent. */
+  submitLabel?: string
+}
+
+/**
+ * Narrow a request to a renderable form card, or return undefined to leave it
+ * to the generic question flow. Accepts one question whose intent is `form`
+ * with a non-empty field list; everything else stays generic.
+ */
+export function formOf(questions: readonly QuestionItem[]): QuestionForm | undefined {
+  if (questions.length !== 1) return undefined
+  // Length-checked above; the index read is the narrowing tax, not a guess.
+  const question = questions[0] as QuestionItem
+  const intent = question.intent
+  if (intent?.kind !== 'form' || !Array.isArray(intent.fields) || intent.fields.length === 0) return undefined
+  return {
+    id: question.id,
+    question: question.question,
+    ...(question.header === undefined ? {} : { header: question.header }),
+    ...(question.detail === undefined ? {} : { detail: question.detail }),
+    fields: intent.fields,
+    ...(intent.submitLabel === undefined ? {} : { submitLabel: intent.submitLabel }),
+  }
+}
