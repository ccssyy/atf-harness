@@ -0,0 +1,116 @@
+import { useMemo, useState, type ChangeEvent } from 'react'
+import { Button, StateDot } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { AskUserQuestionFormField } from '@deepseek-ai/dsh-user-questions/types'
+import type { PendingQuestion, QuestionComposerProps, QuestionForm } from './contract/slots.ts'
+import css from './FormPanel.module.css'
+
+/** The panel's own props: the question domain face, the narrowed form, and the locale seat. */
+export type FormPanelProps =
+  { pending: PendingQuestion; form: QuestionForm } & Pick<QuestionComposerProps, 't'>
+
+/** Initial draft values: each field prefilled from its current `value`. */
+const initialDraftOf = (fields: readonly AskUserQuestionFormField[]): Record<string, string> =>
+  Object.fromEntries(fields.map(field => [field.key, field.value ?? '']))
+
+/**
+ * Render a 'form' intent question as a structured multi-field card (ATF
+ * 批㊶-W F5, vendor patch 0003): one labelled input per field, prefilled with
+ * the current value, with the field's domain hint under it. Submitting
+ * encodes every field as a `key=value` entry of the answer's `selected` —
+ * the protocol encoding is unchanged, so a caller reads the same shape the
+ * generic flow produces. A required field left empty is rejected locally
+ * with a visible message; nothing is silently dropped.
+ *
+ * The form collects values only — authorization stays with the caller's own
+ * approval surface downstream.
+ *
+ * @param props - the question domain face, the narrowed form, and `t`.
+ * @returns The form takeover for this request.
+ */
+export function FormPanel({ pending, form, t }: FormPanelProps) {
+  const initial = useMemo(() => initialDraftOf(form.fields), [form.fields])
+  const [values, setValues] = useState<Record<string, string>>(initial)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const update = (key: string, event: ChangeEvent<HTMLInputElement | HTMLTextAreaElement>): void => {
+    setValues(current => ({ ...current, [key]: event.target.value }))
+    setError(null)
+  }
+  const submit = (): void => {
+    const missing = form.fields.filter(field => field.required === true && (values[field.key] ?? '').trim() === '')
+    if (missing.length > 0) {
+      setError(`${t('form.required')}: ${missing.map(field => field.label).join('、')}`)
+      return
+    }
+    const selected = form.fields
+      .map(field => `${field.key}=${(values[field.key] ?? '').trim()}`)
+    // Same settlement shape as the plan review: an rpc send resolves locally
+    // (dismiss after send); a waterfall send is closed by the projection.
+    const remote = pending.snapshot().channel === 'rpc'
+    setBusy(true)
+    setError(null)
+    void pending.answer({ answers: [{ id: form.id, selected }] })
+      .then(() => {
+        if (!remote) return
+        setBusy(false)
+        void pending.dismiss().catch(() => { setError(t('status.sent')) })
+      })
+      .catch((cause: unknown) => {
+        setBusy(false)
+        setError(cause instanceof Error ? cause.message : String(cause))
+      })
+  }
+  return (
+    <div className={css.frame} data-form-key={pending.key}>
+      <section className={css.card} aria-label={form.question} aria-busy={busy}>
+        <div className={css.strip}>
+          <StateDot state={busy ? 'ongoing' : 'warning'} />
+          {form.header ?? t('form.header')}
+        </div>
+        <div className={css.body}>
+          <h3 className={css.title}>{form.question}</h3>
+          {form.detail !== undefined && <p className={css.detail}>{form.detail}</p>}
+          <div className={css.fields}>
+            {form.fields.map(field => (
+              <label key={field.key} className={css.fieldRow}>
+                <span className={css.fieldLabel}>
+                  {field.label}
+                  {field.required === true && <span className={css.requiredMark}>*</span>}
+                </span>
+                {(field.value ?? '').includes('\n') || field.key === 'base_model_path'
+                  ? (
+                    <textarea
+                      className={css.fieldInput}
+                      value={values[field.key] ?? ''}
+                      placeholder={field.placeholder}
+                      disabled={busy}
+                      rows={2}
+                      onChange={event => { update(field.key, event) }}
+                    />
+                  )
+                  : (
+                    <input
+                      className={css.fieldInput}
+                      value={values[field.key] ?? ''}
+                      placeholder={field.placeholder}
+                      disabled={busy}
+                      onChange={event => { update(field.key, event) }}
+                    />
+                  )}
+                {field.hint !== undefined && <span className={css.fieldHint}>{field.hint}</span>}
+              </label>
+            ))}
+          </div>
+        </div>
+        <div className={css.footer}>
+          <div className={css.feedback} role="status">{error}</div>
+          <div className={css.actions}>
+            <Button variant="primary" disabled={busy} onClick={submit}>
+              {form.submitLabel ?? t('form.submit')}
+            </Button>
+          </div>
+        </div>
+      </section>
+    </div>
+  )
+}
